@page "/usuarios"
@using sharpness_sharp.Components.Pages.UIComponents
@using sharpness_sharp.Data

@inject ApplicationAuthDbContext _dbService

<EditForm FormName="agregar-cafe" Model="@newUser" OnSubmit="@AgregarUsuario">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="max-w-xl mx-auto bg-white p-6 rounded-xl shadow-md space-y-4">

        <h2 class="text-2xl font-bold text-[#38251C]">
            Agregar nuevo usuario
        </h2>

        <div>
            <label>Nombre de usuario</label>
            <InputText @bind-Value="newUser.UserName"
                       class="w-full border p-2 rounded-lg" />
        </div>

        <div>
            <label>Email</label>
            <InputText @bind-Value="newUser.Email"
                       class="w-full border p-2 rounded-lg" />
        </div>

        <button type="submit"
                class="bg-[#38251C] text-white px-6 py-3 rounded-xl">
            Guardar Usuario
        </button>

    </div>

</EditForm>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
    @foreach(ApplicationUser user in lstUsuarios)
    {
        <div class="border">
            <h2>Username: @user.UserName</h2>
            <h2>Correo: @user.Email</h2>
        </div>

        <CoffeCard></CoffeCard>
    }
</div>


@code {
    private List<ApplicationUser> lstUsuarios = new();
    private ApplicationUser newUser = new ApplicationUser();

    protected override Task OnInitializedAsync()
    {
        lstUsuarios = _dbService.Users.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarUsuario()
    {
        _dbService.Users.Add(newUser);
        _dbService.SaveChanges();
        newUser = new();
        return Task.CompletedTask;
    }

}
