@page "/catalogo"
@using System.Runtime.InteropServices
@using Microsoft.EntityFrameworkCore
@using sharpness_sharp.Components.Pages.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@inject ApplicationAuthDbContext _dbService


<div class="min-h-screen bg-[#F8F5F0]">

    <!-- ENCABEZADO -->
    <header class="bg-[#38251C] text-white px-6 py-12 text-center">
        <p class="text-[#D6AD75] uppercase tracking-[5px] text-sm mb-3">
            Café artesanal
        </p>

        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4">
            Aroma & Café
        </h1>

        <p class="text-[#E8D9C8] text-lg max-w-2xl mx-auto">
            Cada taza cuenta una historia. Descubre nuestros sabores
            y disfruta el verdadero placer del café.
        </p>

        <div class="w-24 h-1 bg-[#C99A60] mx-auto mt-6 rounded-full"></div>
    </header>

    <!-- PRESENTACIÓN -->
    <section class="text-center px-6 py-10">
        <p class="text-[#B17A45] uppercase tracking-widest text-sm font-bold mb-2">
            Nuestro menú
        </p>

        <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#38251C]">
            Una experiencia en cada sorbo
        </h2>

        <p class="text-gray-500 mt-3">
            Preparados con pasión, ingredientes seleccionados y mucho amor.
        </p>
    </section>

    
<!-- CATÁLOGO -->
<section class="max-w-7xl mx-auto px-6 pb-16">

    <!-- BOTONES DE ACCIÓN -->
    <div class="flex flex-col sm:flex-row justify-center
        items-center gap-4 mb-10">

        <button @onclick="MostrarMensaje"
            class="w-full sm:w-auto bg-[#38251C]
            hover:bg-[#754522] text-white font-bold
            px-8 py-3 rounded-xl shadow-md
            hover:shadow-xl transition-all duration-300
            active:scale-95">
            ¡Pulsa aquí!
        </button>

        <button @onclick="AgregarCafe"
            class="w-full sm:w-auto bg-[#C99A60]
            hover:bg-[#B17A45] text-white font-bold
            px-8 py-3 rounded-xl shadow-md
            hover:shadow-xl transition-all duration-300
            active:scale-95">
            + Agregar café
        </button>

    </div>

    @if (lstMensajes.Count > 0)
    {
        <div class="max-w-xl mx-auto mb-10 space-y-3">

            @foreach (var mensaje in lstMensajes)
            {
                <div class="bg-[#F3E8D9] border-l-4 border-[#C99A60] text-[#38251C] px-5 py-4 rounded-xl shadow-sm font-semibold">
                    @mensaje
                </div>
            }

        </div>
    }

    <EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="@AgregarCafe">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="max-w-xl mx-auto bg-white p-6 rounded-xl shadow-md space-y-4">

        <h2 class="text-2xl font-bold text-[#38251C]">
            Agregar nuevo café
        </h2>

        <div>
            <label>Imagen del café</label>
            <InputText @bind-Value="newCafe.Imagen"
                       class="w-full border p-2 rounded-lg" />
        </div>

        <div>
            <label>Nombre del café</label>
            <InputText @bind-Value="newCafe.NombreCafe"
                       class="w-full border p-2 rounded-lg" />
        </div>

        <div>
            <label>Descripción</label>
            <InputText @bind-Value="newCafe.DescripcionCafe"
                       class="w-full border p-2 rounded-lg" />
        </div>

        <div>
            <label>Precio</label>
            <InputNumber @bind-Value="newCafe.PrecioCafe"
                         class="w-full border p-2 rounded-lg" />
        </div>

        <button type="submit"
                class="bg-[#38251C] text-white px-6 py-3 rounded-xl">
            Guardar café
        </button>

    </div>

</EditForm>

    <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#38251C]">Nuestro catálogo de cafés</h2>
        <p class="text-gray-500 mt-2"> Descubre todas nuestras especialidades </p>
        <div class="w-20 h-1 bg-[#C99A60] mx-auto mt-4 rounded-full"> </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2
        lg:grid-cols-3 xl:grid-cols-4 gap-8">

        @foreach (Cafe cafe in lstCafes)
        {
            <CoffeCard
                Id="@cafe.Id"
                Imagen="@cafe.Imagen"
                NombreCafe="@cafe.NombreCafe"
                DescripcionCafe="@cafe.DescripcionCafe"
                PrecioCafe="@cafe.PrecioCafe" 
                EnviarNotificacionActualizacion="ActualizarProducto"
                EnviarNotificacionEliminar="EliminarProducto"/>
        }


    </div>

</section>


    <footer class="bg-[#38251C] text-center text-[#E8D9C8] py-8 px-4">
        <h3 class="text-2xl font-serif font-bold text-white mb-2">
            Aroma & Café
        </h3>

        <p class="text-sm">
            El aroma que alegra tus días
        </p>

        <p class="text-xs text-[#BDA58F] mt-4">
            © 2026 Aroma & Café - Todos los derechos reservados
        </p>
    </footer>

    

</div>


@code {

    private List<string> lstMensajes = new();
    private Cafe newCafe = new Cafe();
    private List<Cafe> lstCafes = new();


    private void MostrarMensaje()
    {
        lstMensajes.Add("No me toques");
    }
    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();
        newCafe = new();
        return Task.CompletedTask;
    }
    private Task ActualizarProducto(Cafe cafeEditado)
    {
        Cafe cafeParaEditar = _dbService.Cafes.FirstOrDefault(cafe => cafe.Id == cafeEditado.Id);
        Console.WriteLine(cafeEditado.Id);
        Console.WriteLine(cafeEditado.Imagen);
        Console.WriteLine(cafeEditado.NombreCafe);
        Console.WriteLine(cafeEditado.DescripcionCafe);
        Console.WriteLine(cafeEditado.PrecioCafe);

        cafeParaEditar.Imagen = cafeEditado.Imagen;
        cafeParaEditar.NombreCafe = cafeEditado.NombreCafe;
        cafeParaEditar.PrecioCafe = cafeEditado.PrecioCafe;
        cafeParaEditar.DescripcionCafe = cafeEditado.DescripcionCafe;

        _dbService.SaveChanges();

    return Task.CompletedTask;
    }
    private void EliminarProducto(int id)
    {
        Cafe? cafe = lstCafes.FirstOrDefault(c=>c.Id==id);
        if(cafe is null)
        {
            return;
        }
        _dbService.Cafes.Remove(cafe);
        _dbService.SaveChanges();
        lstCafes.Remove(cafe);
    }
}