@using sharpness_sharp.Components.Pages.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@using System.Security.Claims
@inject AuthenticationStateProvider _auth 
@inject ApplicationAuthDbContext _dbService

<div class="flex flex-col justify-center gap-4
            border border-gray-200 rounded-2xl
            p-5 m-2 bg-white shadow-md">

    @* Imagen del café *@
    <div class="flex flex-col gap-2">

        <input type="text"
               @bind="Imagen"
               disabled="@(!ModoEdicion)"
               class="w-full border border-gray-300 rounded-lg
                      p-2 text-sm focus:outline-none
                      focus:ring-2 focus:ring-amber-400" />

        <img src="@Imagen"
             class="w-full h-48 object-cover rounded-xl"
             alt="Imagen del café" />

    </div>

    @* Nombre del café *@
    <input type="text"
           @bind="NombreCafe"
           disabled="@(!ModoEdicion)"
           class="font-bold text-2xl text-gray-800
                  border-b border-gray-200 p-2
                  focus:outline-none focus:border-amber-500
                  disabled:bg-white" />

    @* Descripción del café *@
    <input type="text"
           @bind="DescripcionCafe"
           disabled="@(!ModoEdicion)"
           class="text-gray-600 text-sm
                  border-b border-gray-200 p-2
                  focus:outline-none focus:border-amber-500
                  disabled:bg-white" />

    @* Precio *@
    <input type="number"
           @bind="PrecioCafe"
           disabled="@(!ModoEdicion)"
           class="font-bold text-amber-900 bg-amber-100
                  hover:bg-amber-200 transition-colors
                  rounded-xl p-3 text-center
                  focus:outline-none disabled:cursor-default"
           step="0.50" />

    <p class="text-center text-sm text-gray-500">
        Bs.
    </p>

    @* Botón de edición *@
    @if (ModoEdicion)
    {
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="font-bold text-white rounded-xl p-3
                            shadow-sm transition-colors"
                            style="background-color: #16a34a;"
                        @onclick="() => {
                            CambiarModoEdicion();
                            ActualizarProducto();
                            }"">
                    Guardar
                </button>
            </Authorized>
        </AuthorizeView>
    }
    else
    {
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="font-bold text-white bg-yellow-600
                            hover:bg-yellow-700 rounded-xl p-3
                            transition-colors shadow-sm"
                        @onclick="CambiarModoEdicion">
                    Editar
                </button>
            </Authorized>
        </AuthorizeView>
    }
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="font-bold text-white rounded-xl p-3
                            shadow-sm transition-colors"
                            style="background-color: #972511;"
                        @onclick="EliminarProducto">
                    Eliminar
            </button>
        </Authorized>
        <NotAuthorized>No tienes permiso por gil</NotAuthorized>
    </AuthorizeView>
    <AuthorizeView Roles="Cliente">
        <Authorized>
            <div class="font-bold text-white rounded-xl p-3
                            shadow-sm transition-colors"
                            style="background-color: #116d97;">
                <input type="number" placeholder="cantidad" 
                @onclick="RegistrarCompra" @bind="cantidadCafes"/>
                <button  class="ui-btn bg-green-600">Comprar</button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {

    private bool ModoEdicion = false;
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Imagen { get; set; }
    [Parameter] public string? NombreCafe { get; set; }
    [Parameter] public string? DescripcionCafe { get; set; }
    [Parameter] public decimal PrecioCafe { get; set; }
    [Parameter] public EventCallback<Cafe> EnviarNotificacionActualizacion { get; set; }
    [Parameter] public EventCallback<int> EnviarNotificacionEliminar { get; set; }
    private int cantidadCafes;
    private void CambiarModoEdicion()
    {
        ModoEdicion = !ModoEdicion;
        StateHasChanged();
    }
    private Task ActualizarProducto()
    {
        EnviarNotificacionActualizacion.InvokeAsync(new()
        {
            Id=Id,
            Imagen = Imagen,
            NombreCafe = NombreCafe,
            DescripcionCafe = DescripcionCafe,
            PrecioCafe = PrecioCafe,
        });
        return Task.CompletedTask;
    }
    private Task EliminarProducto()
    {
        EnviarNotificacionEliminar.InvokeAsync(Id);
        return Task.CompletedTask;
    }
    private async Task RegistrarCompra()
    {
        var user = (await _auth.GetAuthenticationStateAsync()).User;
 
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        _dbService.Ventas.Add(new Ventas(userId, Id, cantidadCafes, (double)PrecioCafe*cantidadCafes, DateTime.Now));
        _dbService.SaveChanges();
    }
}