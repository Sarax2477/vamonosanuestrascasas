<div class="group bg-white rounded-2xl overflow-hidden shadow-md
    hover:shadow-2xl transition-all duration-300
    hover:-translate-y-2 border border-[#EDE5DA]">

    <!-- IMAGEN -->
    <div class="relative overflow-hidden h-56">
        <img src="@Imagen"
            alt="@NombreCafe"
            class="w-full h-full object-cover
            group-hover:scale-110 transition-transform duration-500" />

        <div class="absolute top-3 right-3 bg-[#38251C]
            text-white text-xs px-4 py-2 rounded-full shadow">
                Especialidad
        </div>
    </div>                                 

    <!-- INFORMACIÓN -->
    <div class="p-5">
        <h3 class="text-xl font-serif font-bold text-[#38251C] mb-2">
            @NombreCafe
        </h3>

        <p class="text-gray-500 text-sm leading-relaxed min-h-[48px]">
            @DescripcionCafe
        </p>

        <div class="flex items-center justify-between mt-5 pt-4
            border-t border-[#EEE5DB]">

        <span class="text-xs uppercase tracking-wider text-gray-400">
            Precio
        </span>

        <span class="bg-[#F3E8D9] text-[#754522]
            font-bold text-lg px-4 py-2 rounded-xl">
            Bs. @PrecioCafe
        </span>

    </div>

</div>
</div>

@code{
    [Parameter] public string? Imagen { get; set; }
    [Parameter] public string? NombreCafe { get; set; }
    [Parameter] public string? DescripcionCafe { get; set; }
    [Parameter] public decimal PrecioCafe { get; set; }
}